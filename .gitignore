# Tài liệu đầu vào chỉ dùng tại máy cá nhân.
prompt_khoi_tao_project.md
YEU_CAU.md
.local/

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.DS_Store
.env
.env.*
_build/
build/
dist/
/tests/

# Giữ cấu trúc thư mục, không đưa dữ liệu thô lên Git.
data/raw/*
!data/raw/sources/
!data/raw/unzipped/
data/raw/sources/*
!data/raw/sources/.gitkeep
data/raw/unzipped/*
!data/raw/unzipped/.gitkeep
data/shards/*/*.parquet
# Checkpoint --resume (Parquet tạm theo lô) chỉ dùng tại máy chạy.
data/shards/*/_checkpoint/
data/mock/
data/**/stats.json
data/test_single/
data/parsed*/
data/audits/
data/cache/
data/repaired*/
data/enriched*/
data/report_inputs/
.venv-report/
/scratch/
/crawling_content.txt
*.log

# Corpus/measurements stay out of the code repository; retain directory placeholders.
data/**
!data/**/
!data/**/.gitkeep
